---
// Article.astro — renders one article + its comment thread
import Giscus from './Giscus.astro';

interface Props {
  title: string;
  date: Date;
  slug: string;
  filename: string;
  body: string;
  Content: any;
}

const { title, date, slug, filename, Content } = Astro.props;

// Format date as [YYYY.MM.DD // HH:MM:SS] — time is midnight UTC since we only have a date
const pad = (n: number) => String(n).padStart(2, '0');
const d = date;
const dateStr = `${d.getUTCFullYear()}.${pad(d.getUTCMonth() + 1)}.${pad(d.getUTCDate())} // 00:00:00`;
---

<article class="article" id={slug}>
  <p class="article-prompt" aria-hidden="true">
    <span class="prompt-dollar">$</span> cat {filename}
  </p>
  <p class="article-timestamp">
    [{dateStr}]
  </p>
  <h2 class="article-title">{title.toUpperCase()}</h2>

  <div class="article-body prose">
    <Content />
  </div>

  <Giscus slug={slug} title={title} />
</article>

<style>
  .article {
    margin-bottom: 0;
  }

  .article-prompt {
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--color-dim);
    margin: 0 0 0.3rem;
  }

  .prompt-dollar {
    color: var(--color-phosphor);
    margin-right: 0.5ch;
  }

  .article-timestamp {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    color: var(--color-amber);
    text-shadow: 0 0 4px var(--color-amber);
    margin: 0 0 0.5rem;
    letter-spacing: 0.02em;
  }

  .article-title {
    font-family: var(--font-heading);
    font-size: clamp(2rem, 5vw, 2.8rem);
    font-weight: 400;
    color: var(--color-phosphor);
    text-shadow: 0 0 10px var(--color-phosphor), 0 0 20px rgba(51, 255, 102, 0.3);
    margin: 0 0 2rem;
    letter-spacing: 0.05em;
    line-height: 1.1;
  }

  /* ─── Prose styles — everything inside article body ─── */
  .prose {
    font-family: var(--font-mono);
    font-size: 1rem;
    line-height: 1.75;
    color: var(--color-phosphor);
    letter-spacing: 0.01em;
  }

  /* Headings inside articles show markdown prefix literally */
  .prose :global(h2)::before {
    content: '## ';
    color: var(--color-dim);
    font-size: 0.9em;
  }
  .prose :global(h3)::before {
    content: '### ';
    color: var(--color-dim);
    font-size: 0.9em;
  }

  .prose :global(h2),
  .prose :global(h3) {
    font-family: var(--font-heading);
    font-weight: 400;
    color: var(--color-phosphor);
    text-shadow: 0 0 6px var(--color-phosphor);
    margin: 2.5rem 0 0.75rem;
    letter-spacing: 0.04em;
  }

  .prose :global(h2) { font-size: 1.8rem; }
  .prose :global(h3) { font-size: 1.4rem; }

  .prose :global(p) {
    margin: 0 0 1.2rem;
  }

  /* Inline code — cyan, no background */
  .prose :global(code:not(pre code)) {
    font-family: var(--font-mono);
    color: var(--color-cyan);
    font-size: 0.93em;
    background: none;
    border: none;
    padding: 0;
  }

  /* Code blocks */
  .prose :global(pre) {
    position: relative;
    background: #0a120a;
    border: 1px solid var(--color-dim);
    padding: 1.2rem 1rem 1rem;
    margin: 1.5rem 0;
    overflow-x: auto;
    font-size: 0.88rem;
    line-height: 1.6;
  }

  .prose :global(pre)::after {
    content: '[ CODE ]';
    position: absolute;
    top: 0.3rem;
    right: 0.6rem;
    font-size: 0.65rem;
    color: var(--color-dim);
    font-family: var(--font-mono);
    letter-spacing: 0.05em;
  }

  .prose :global(pre code) {
    color: var(--color-phosphor);
    background: none;
    border: none;
    padding: 0;
    font-size: inherit;
  }

  /* Links */
  .prose :global(a) {
    color: var(--color-phosphor);
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: color 0.15s, text-shadow 0.15s;
  }

  .prose :global(a:hover) {
    color: var(--color-magenta);
    text-shadow: 0 0 8px var(--color-magenta);
  }

  /* Blockquotes */
  .prose :global(blockquote) {
    border-left: 4px solid var(--color-magenta);
    margin: 1.5rem 0;
    padding: 0.5rem 0 0.5rem 1.2rem;
    font-style: italic;
    color: var(--color-dim);
  }

  .prose :global(blockquote p) {
    margin: 0;
  }

  /* Unordered lists — bullets replaced with > */
  .prose :global(ul) {
    list-style: none;
    padding: 0;
    margin: 1rem 0 1.2rem;
  }

  .prose :global(ul li)::before {
    content: '> ';
    color: var(--color-dim);
  }

  .prose :global(ul li) {
    margin-bottom: 0.4rem;
  }

  /* Ordered lists — [01] [02] style */
  .prose :global(ol) {
    list-style: none;
    padding: 0;
    margin: 1rem 0 1.2rem;
    counter-reset: ol-counter;
  }

  .prose :global(ol li) {
    counter-increment: ol-counter;
    margin-bottom: 0.4rem;
  }

  .prose :global(ol li)::before {
    content: '[' counter(ol-counter, decimal-leading-zero) '] ';
    color: var(--color-dim);
    font-variant-numeric: tabular-nums;
  }

  /* Horizontal rules → row of ═ */
  .prose :global(hr) {
    border: none;
    margin: 2rem 0;
    overflow: hidden;
    height: 1.2em;
  }

  .prose :global(hr)::after {
    content: '════════════════════════════════════════════════════════════════════════════';
    font-family: var(--font-mono);
    font-size: 0.85rem;
    color: var(--color-dim);
    display: block;
    white-space: nowrap;
    overflow: hidden;
  }

  /* Strong / em */
  .prose :global(strong) {
    color: var(--color-phosphor);
    font-weight: 700;
  }

  .prose :global(em) {
    color: var(--color-dim);
    font-style: italic;
  }
</style>
