---
// Giscus.astro — one iframe comment thread per article
// Each article gets its own <iframe> with a unique ?term= so threads don't collide.
// Height is managed via postMessage from giscus.app.

interface Props {
  slug: string;
  title: string;
}

const { slug, title } = Astro.props;

const REPO        = 'anthoro/ta-chwila';
const REPO_ID     = 'R_kgDOSpEHiw';
const CATEGORY    = 'Announcements';
const CATEGORY_ID = 'DIC_kwDOSpEHi84C9_wy';

// Strip trailing slash so theme URL is clean
const siteUrl = (Astro.site?.toString() ?? 'http://localhost:4321').replace(/\/$/, '');
const themeUrl = `${siteUrl}/giscus.css`;

const params = new URLSearchParams({
  repo:             REPO,
  repoId:           REPO_ID,
  category:         CATEGORY,
  categoryId:       CATEGORY_ID,
  mapping:          'specific',
  term:             slug,
  strict:           '1',
  reactionsEnabled: '1',
  emitMetadata:     '0',
  inputPosition:    'top',
  theme:            themeUrl,
  lang:             'en',
});

const iframeSrc = `https://giscus.app/widget?${params.toString()}`;
---

<div class="comments-section">
  <p class="comments-header" aria-hidden="true">
    ─────────────────────── ┤ COMMENTS ├ ───────────────────────
  </p>

  <iframe
    class="giscus-frame"
    src={iframeSrc}
    title={`Comments for ${title}`}
    loading="lazy"
    width="100%"
    scrolling="no"
    aria-label={`Comment thread for ${title}`}
  ></iframe>
</div>

<!-- One shared listener handles all iframes on the page -->
<script>
  window.addEventListener('message', (event: MessageEvent) => {
    if (event.origin !== 'https://giscus.app') return;
    const data = event.data;
    if (typeof data !== 'object' || !data?.giscus?.resizeHeight) return;

    // Match the iframe that sent the message by its contentWindow
    document.querySelectorAll<HTMLIFrameElement>('.giscus-frame').forEach((frame) => {
      if (frame.contentWindow === event.source) {
        frame.style.height = `${data.giscus.resizeHeight}px`;
      }
    });
  });
</script>

<style>
  .comments-section {
    margin-top: 2.5rem;
  }

  .comments-header {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    color: var(--color-dim);
    margin: 0 0 1.5rem;
    white-space: nowrap;
    overflow: hidden;
  }

  .giscus-frame {
    border: none;
    background: transparent;
    display: block;
    min-height: 120px;
    width: 100%;
    color-scheme: dark;
    transition: height 0.2s ease;
  }
</style>
