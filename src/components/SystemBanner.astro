---
// SystemBanner.astro — rendered once at the top of the page
---
<header class="system-banner" aria-label="System banner">
  <pre class="ascii-logo" aria-hidden="true"> _/\_      ____  _   _   _    _  _____  _       ___
/ o o \   / ___|| | | | | \  / ||_   _|| |     / _ \
|  _  |  | |    | |_| | |  \/  |  | |  | |    | |_| |
| \ / |  | |    |  _  | |  /\  |  | |  | |    |  _  |
 \___/   | |___ | | | | | /  \ |  | |  | |___ | | | |
  |||     \____||_| |_| |/    \|  |_|  |_____|_| |_|</pre>
  <p class="banner-line">
    CHWILA.SYS v1.0 // UNAUTHORIZED ACCESS WILL BE TRACED // TYPE 'help' OR JUST READ
  </p>
  <p class="banner-divider" aria-hidden="true">═══════════════════════════════════════════════════════════════════════════════</p>
</header>

<style>
  .system-banner {
    margin-bottom: 4rem;
  }

  .ascii-logo {
    font-family: var(--font-mono);
    font-size: clamp(0.55rem, 1.4vw, 0.82rem);
    color: var(--color-phosphor);
    text-shadow: 0 0 6px var(--color-phosphor);
    line-height: 1.3;
    white-space: pre;
    overflow-x: auto;
    margin: 0 0 0.25rem;
  }

  .banner-line {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    color: var(--color-amber);
    text-shadow: 0 0 5px var(--color-amber);
    margin: 0.4rem 0;
    letter-spacing: 0.03em;
  }

  .banner-divider {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    color: var(--color-dim);
    margin: 0;
    overflow: hidden;
    white-space: nowrap;
  }
</style>
