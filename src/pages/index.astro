---
import { getCollection, render } from 'astro:content';
import SystemBanner from '../components/SystemBanner.astro';
import Article from '../components/Article.astro';
import Divider from '../components/Divider.astro';
import Scanlines from '../components/Scanlines.astro';
import BlinkingCursor from '../components/BlinkingCursor.astro';
import '../styles/global.css';

// Fetch and sort articles newest-first
const rawArticles = await getCollection('articles');
const articles = rawArticles.sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);

const siteTitle = 'ANTONI.SYS';
const siteDescription = 'Personal blog. Terminal aesthetic. No apologies.';

// Pre-render all article content
const renderedArticles = await Promise.all(
  articles.map(async (article) => {
    const { Content } = await render(article);
    const filename = article.id.split('/').pop() ?? `${article.data.slug}.md`;
    return { article, Content, filename };
  })
);
---
<!doctype html>
<html lang="en">
<head>
  <!--
  ╔═══════════════════════════════════════════════════╗
  ║  SYSTEM: ANTONI.SYS v1.0                         ║
  ║  STATUS: OPERATIONAL                              ║
  ║  WARNING: UNAUTHORIZED ACCESS WILL BE TRACED      ║
  ╚═══════════════════════════════════════════════════╝
  -->
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <meta name="description" content={siteDescription} />
  <meta name="generator" content={Astro.generator} />
  <title>{siteTitle}</title>

  <!-- Preload critical font weights -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

  <!-- Favicon -->
  <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

  <!-- RSS -->
  <link rel="alternate" type="application/rss+xml" title={siteTitle} href="/rss.xml" />
</head>
<body>
  <!-- Boot sequence — fires once per session via sessionStorage -->
  <div id="boot-screen" role="status" aria-live="polite">
    <span class="boot-line">BOOTING ANTONI.SYS...</span>
    <span class="boot-line">LOADING /home/antoni/blog...</span>
    <span class="boot-line">READY.</span>
  </div>

  <!-- CRT overlay -->
  <Scanlines />

  <main class="site-wrapper">
    <SystemBanner />

    {renderedArticles.map(({ article, Content, filename }, i) => (
      <>
        <Article
          title={article.data.title}
          date={article.data.date}
          slug={article.data.slug}
          filename={filename}
          body=""
          Content={Content}
        />
        {i < renderedArticles.length - 1 && <Divider />}
      </>
    ))}

    <BlinkingCursor />
  </main>

  <!-- Boot sequence JS — only runs once per session -->
  <script>
    const boot = document.getElementById('boot-screen');
    if (boot) {
      if (sessionStorage.getItem('booted')) {
        boot.style.display = 'none';
      } else {
        sessionStorage.setItem('booted', '1');
        boot.classList.add('fade-out');
        boot.addEventListener('animationend', () => boot.remove(), { once: true });
        setTimeout(() => boot.remove(), 2500);
      }
    }
  </script>

  <!-- Konami code easter egg -->
  <script>
    const KONAMI = [
      'ArrowUp','ArrowUp','ArrowDown','ArrowDown',
      'ArrowLeft','ArrowRight','ArrowLeft','ArrowRight',
      'b','a'
    ];
    let seq: string[] = [];

    document.addEventListener('keydown', (e: KeyboardEvent) => {
      seq.push(e.key);
      if (seq.length > KONAMI.length) seq.shift();
      if (seq.join(',') === KONAMI.join(',')) {
        document.body.classList.add('glitch-active');
        setTimeout(() => document.body.classList.remove('glitch-active'), 600);
        seq = [];
      }
    });
  </script>
</body>
</html>
